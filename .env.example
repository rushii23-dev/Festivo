# Copy to .env.local and fill in. Never commit real keys.

# AI provider: "mock" (no key needed, realistic demo plans) or "gemini".
# Leave unset to use Gemini when GEMINI_API_KEY is set, and demo mode otherwise.
AI_PROVIDER=mock

# Required for AI_PROVIDER=gemini. Server-side only; never exposed to the browser.
GEMINI_API_KEY=your-gemini-api-key
# Any Gemini model with structured JSON output. The alias tracks the latest Flash model.
GEMINI_MODEL=gemini-flash-latest

# Demo mode: total artificial delay (ms) so the streamed progress is visible.
MOCK_STREAM_DELAY_MS=1200

# AI requests allowed per client per minute (default 8).
API_RATE_LIMIT_PER_MINUTE=8

# Proxies in front of the app that append to X-Forwarded-For: 1 for Vercel or Cloud
# Run on its own, 2 with an extra load balancer in front of Cloud Run. The client
# address is read this many entries from the right, so a client cannot forge it.
TRUSTED_PROXY_HOPS=1

# Public URL. When it starts with https://, HSTS and upgrade-insecure-requests are sent.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
