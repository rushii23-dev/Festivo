# Copy to .env.local and fill in. Never commit real keys.

# AI provider: "mock" (no key needed, realistic demo plans) or "gemini".
AI_PROVIDER=mock

# Required when AI_PROVIDER=gemini. Server-side only; never exposed to the browser.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Public URL used for metadata and Open Graph links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
